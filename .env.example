# Generate .env from GCP / Firebase CLI (recommended):
#   chmod +x scripts/generate-env.sh
#   ./scripts/generate-env.sh
#
# That script uses: gcloud config get-value project, gcloud auth application-default login,
# and optionally firebase CLI for NEXT_PUBLIC_FIREBASE_*.
#
# Or copy this file to .env and fill values manually below.
# ---------------------------------------------------------------------------

# --- GCP (Firestore, Cloud Storage, Firebase Admin) ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-project-id-blog-images

# Leave unset to use Application Default Credentials (after: gcloud auth application-default login)
# Or set to path of service account key JSON for server/CI
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json

# --- Firebase (client-side admin login) ---
# From Firebase Console → Project settings → General, or from: firebase apps:sdkconfig web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-gcp-project-id

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Local .terraform directories
.terraform/

# Lock file (optional - you may want to commit this)
.terraform.lock.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive variable files
terraform.tfvars
*.auto.tfvars

# CLI configuration files
.terraformrc
terraform.rc


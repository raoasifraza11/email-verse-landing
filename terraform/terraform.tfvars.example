# =============================================================================
# Example Terraform Variables
# Copy this file to terraform.tfvars and fill in your values
# =============================================================================

# Required: Your GCP Project ID
project_id = "your-gcp-project-id"

# Optional: GCP Region (us-central1 is usually cheapest)
region = "us-central1"

# Optional: Service name
service_name = "emailverse-landing"

# Optional: Docker image configuration
image_name = "emailverse-landing"
image_tag  = "latest"

# Optional: Resource limits (keep small for minimal costs)
cpu_limit    = "1"
memory_limit = "512Mi"
max_instances = 3

# Optional: Custom domain (leave empty to skip)
# custom_domain = "www.yourdomain.com"
custom_domain = ""

